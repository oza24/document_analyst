{
  "buildCommand": "cd .. && npm run build --workspace=@oza24/shared-types && npm run build --workspace=frontend",
  "outputDirectory": "dist",
  "installCommand": "cd .. && npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://document-analyst-1.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://document-analyst-1.onrender.com/health"
    }
  ]
}
